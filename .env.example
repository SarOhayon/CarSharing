# Copy this file to .env and fill in real values. .env is git-ignored.

# Port for the API / production server
PORT=3001

# Your family's time zone (recurring events + SMS reminders use it)
TZ=America/New_York

# Secret used to sign login sessions. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Code a family member must enter to join or to claim their profile the first time
FAMILY_CODE=change-me

# How many days ahead anyone can book without approval
BOOKING_WINDOW_DAYS=14

# SMS reminders via Twilio (leave blank to just log texts to the console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# When to text reminders, in minutes before a reservation starts (comma separated)
REMINDER_OFFSETS_MINUTES=1440,60

# Public URL of the site, used in text messages
APP_URL=http://localhost:5173
