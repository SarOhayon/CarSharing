# Copy this file to .env and fill in real values. .env is git-ignored.

# Port for the API / production server
PORT=3001

# Your family's time zone (recurring events + reminder emails use it)
TZ=America/New_York

# Secret used to sign login sessions. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Code a family member must enter to join or to claim their profile the first time
FAMILY_CODE=change-me

# How many days ahead anyone can book without approval
BOOKING_WINDOW_DAYS=14

# Email notifications via Resend (https://resend.com). Server-side only —
# these are never sent to the browser. Leave blank to just log emails to the console.
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend, e.g. "Family Car Share <cars@yourdomain.com>"
EMAIL_FROM=

# When to email pickup instructions, in minutes before a reservation starts (comma separated)
REMINDER_OFFSETS_MINUTES=1440,60

# Public URL of the site, used for the button in emails
APP_URL=http://localhost:5173
